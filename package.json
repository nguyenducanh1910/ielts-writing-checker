{
  "name": "ielts-writing-scoring",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IELTS Writing practice and scoring app (Vite front end + Google Apps Script back end)",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps-script/tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "mock-api": "tsx mock-server/server.ts",
    "gas:build": "node apps-script/build.mjs",
    "gas:push": "npm run gas:build && cd apps-script && clasp push",
    "check": "npm run lint && npm run build && npm run gas:build && npm test"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "@playwright/test": "^1.64.0",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
